{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/learning-plan.js": { "maxDuration": 120 },
    "api/practice-question.js": { "maxDuration": 90 }
  },
  "rewrites": [
    { "source": "/learn/:path*", "destination": "/index.html" },
    { "source": "/login", "destination": "/index.html" },
    { "source": "/extension", "destination": "/index.html" },
    { "source": "/privacy", "destination": "/index.html" }
  ]
}
