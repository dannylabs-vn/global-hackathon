# Set to Skillmark's published Chrome Web Store listing URL.
# Leave blank for the public /extension preview installation guide.
VITE_CHROME_WEB_STORE_URL=

# Server only: never prefix this key with VITE_. Set in Vercel, then redeploy.
DEEPSEEK_API_KEY=
# Optional model override for your DeepSeek account.
DEEPSEEK_MODEL=deepseek-flash
